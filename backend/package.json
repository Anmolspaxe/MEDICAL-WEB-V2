{
  "name": "medicare-hospital-api",
  "version": "2.0.0",
  "description": "MediCare Hospital — Production Backend: JWT, bcrypt, 2FA, SMS, Email, Audit Trail, Razorpay, RLS",
  "main": "api.js",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "start":      "node api.js",
    "dev":        "nodemon api.js",
    "reminders":  "node reminder.js",
    "remind-now": "node reminder.js --run-now",
    "test":       "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:cover": "jest --coverage --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch":       ["**/*.test.js"],
    "testTimeout":     30000
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios":                 "^1.6.0",
    "bcryptjs":              "^2.4.3",
    "cors":                  "^2.8.5",
    "dotenv":                "^16.3.1",
    "express":               "^4.18.2",
    "express-rate-limit":    "^7.1.5",
    "express-validator":     "^7.0.1",
    "helmet":                "^7.1.0",
    "jsonwebtoken":          "^9.0.2",
    "morgan":                "^1.10.0",
    "node-cron":             "^3.0.3",
    "nodemailer":            "^6.9.7",
    "qrcode":                "^1.5.3",
    "razorpay":              "^2.9.2",
    "speakeasy":             "^2.0.0",
    "twilio":                "^4.19.3"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "nodemon":   "^3.0.2",
    "supertest": "^6.3.3"
  },
  "private": true,
  "license": "UNLICENSED"
}
